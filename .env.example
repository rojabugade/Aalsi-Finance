# Copy to .env and adjust. Compose reads this file. Never commit a filled-in .env.

# --- App ---
ENVIRONMENT=dev
DEBUG=true
# Public origin you load the web app from (scheme + host, no trailing slash).
# Single source of truth: OAuth callback URLs, the post-auth redirect, and the CORS
# default are all derived from it. Set to your domain in prod, localhost:3000 for local.
APP_ORIGIN=http://localhost:3000
# Optional override; defaults to APP_ORIGIN. Comma-separated for multiple origins.
# CORS_ORIGINS=http://localhost:3000

# --- Postgres ---
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance
# Used by the API/worker inside compose (host = service name):
DATABASE_URL=postgresql+asyncpg://finance:finance@postgres:5432/finance

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Object storage (MinIO) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documents
S3_REGION=us-east-1

# --- Document ingestion & storage (M4) ---
MAX_UPLOAD_MB=25
# base64 of 32 random bytes; encrypts stored documents at rest (AES-256-GCM).
# Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# MUST override in prod — rotating it makes existing documents undecryptable.
STORAGE_ENCRYPTION_KEY=ZGV2LWluc2VjdXJlLTMyLWJ5dGUta2V5LS0tLS0tLS0=
SIGNED_URL_TTL_SECONDS=300

# --- OCR & extraction (M5) ---
OCR_ENGINE=paddle
OCR_LANGUAGES=en
# Combined OCR x LLM confidence below this goes to /review-queue.
OCR_CONFIDENCE_THRESHOLD=0.75

# --- Embeddings (must match M1 vector(N) dimension) ---
EMBED_DIM=1536

# --- LLM gateway (M3; OpenAI-compatible base_url) ---
# Swap providers by changing base_url + models only:
#   OpenAI:    https://api.openai.com/v1
#   OpenRouter https://openrouter.ai/api/v1
#   LM Studio: http://localhost:1234/v1   (blank CHAT_MODEL discovers its one loaded LLM)
#   Ollama:    http://localhost:11434/v1
LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# CHAT_MODEL=
# VISION_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small
# Local models may not support these — set false to degrade gracefully.
LLM_SUPPORTS_STRUCTURED_OUTPUT=true
LLM_SUPPORTS_VISION=true
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=86400

# --- Connections (optional external integrations) ---
# OAuth callbacks default to <APP_ORIGIN>/api/<provider>/oauth/callback (routed through
# the web app's /api proxy, so it works in dev, compose, and behind a domain). Register
# that exact URL as the Callback URL in each provider's developer console. Only set the
# *_REDIRECT_URI vars below if you front the API on its own separate public host.
# Plaid sandbox: the default user (user_good/pass_good) returns a small static
# transaction set. For dynamic sandbox transactions, log into Plaid Link with
# username user_transactions_dynamic and password pass_good; the backend cannot
# force that username through Link token creation.
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENVIRONMENT=sandbox
# Optional. Defaults to <APP_ORIGIN>/webhooks/plaid when APP_ORIGIN is HTTPS;
# local sandbox defaults to https://example.com/webhooks/plaid because Plaid only
# needs a valid item webhook URL for sandbox DEFAULT_UPDATE generation.
# PLAID_WEBHOOK_URL=
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=
# SPLITWISE_CONSUMER_KEY=
# SPLITWISE_SECRET=
# SPLITWISE_REDIRECT_URI=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
