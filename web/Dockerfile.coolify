FROM node:22-slim

ENV HOSTNAME=0.0.0.0 \
    PORT=3000 \
    NEXT_PUBLIC_API_URL=/api \
    API_INTERNAL_URL=http://api:8000

WORKDIR /app/web

COPY web/package*.json ./
RUN npm ci

COPY web ./
COPY shared /app/shared

RUN npm run build
RUN npm prune --omit=dev

ENV NODE_ENV=production

EXPOSE 3000

CMD ["npm", "run", "start", "--", "-H", "0.0.0.0", "-p", "3000"]
