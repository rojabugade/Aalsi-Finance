# Web client environment. Copy to .env.local for local dev (Next.js reads it).
# In Docker Compose this is injected from the root .env.

# Direct API origin used for data calls from the browser (Authorization: Bearer).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side API origin the Next rewrite proxy forwards to. REQUIRED for auth:
# /auth/* and /workspace/* are called same-origin so the httpOnly refresh cookie and
# the readable CSRF cookie belong to the SPA origin. Without this, auth requests 404
# (the rewrite is disabled). Compose sets this to http://api:8000; for bare `npm run
# dev` set it to your API, e.g. http://localhost:8000.
API_INTERNAL_URL=http://localhost:8000

# --- Error tracking (optional) ---
# Blank disables Sentry. Events are scrubbed of request bodies, cookies, headers,
# query strings and user identity before sending (see lib/sentry-options.ts).
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Set only in CI/build to upload source maps; builds work fine without it.
# SENTRY_AUTH_TOKEN=
